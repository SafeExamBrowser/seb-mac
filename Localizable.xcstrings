    },
    "A built-in display is required, but not available. If you're using a MacBook, use its internal display and start %@ again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eingebautes Display wird benötigt, ist aber nicht verfügbar. Falls Sie ein MacBook verwenden, benutzen Sie dessen eingebautes Display und starten Sie %@ erneut."
          }
        }
      }
    },
    "A built-in display is required, but not available. If you're using a MacBook, use its internal display. To override this requirement, select the option below and enter the quit/unlock password, which usually exam supervision/support knows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eingebautes Display wird benötigt, ist aber nicht verfügbar. Falls Sie ein MacBook verwenden, benutzen Sie dessen eingebautes Display. Um trotzdem ein externes Display zu benutzen, wählen Sie die Option unten an und geben Sie das Beenden/Entsperren-Passwort ein, welche üblicherweise der Prüfungsaufsicht bekannt sind."
          }
        }
      }
    },
    "A setting contains a double quote followed by a comma, which is not allowed. Please remove it from the setting '%@' and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Einstellung enthält ein doppeltes Anführungszeichen gefolgt von einem Komma, was nicht erlaubt ist. Bitte entfernen Sie es aus der Einstellung '%@' und versuchen Sie es erneut."
          }
        }
      }
    },
    "AAC Assessment Mode Not Supported!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AAC-Bewertungsmodus nicht unterstützt!"
          }
        }
      }
    },
    "Accessibility Permissions Required" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriffsrechte erforderlich für Bedienungshilfen"
          }
        }
      }
    },
    "Activates %@ browser. Right click displays menu with open webpages." : {
      "localizations" : {
        "de" : {
